bound-lock/1 about="name: release\non:\n  workflow_run:\n    workflows: [tag]\n    types: [completed]\n  workflow_dispatch:\njobs:\n  stage:\n    if: github.event_name == 'workflow_dispatch' || (github.event.workflow_run.conclusion == 'success' && github.event.workflow_run.head_branch == 'main')\n    concurrency: release-delivery\n    environment: release\n    runs-on: ubuntu-latest\n    permissions:\n      contents: write\n      id-token: write\n    steps:\n      - uses: actions/checkout@v4\n        with:\n          ref: ${{ github.event.workflow_run.head_sha || github.sha }}\n      - uses: actions/setup-node@v4\n        with:\n          node-version: 24\n      - run: npm install --prefix .instrument --no-save --ignore-scripts @lapxo/bound@0.2.6\n      - run: npm install --global npm@'12.1.0' --ignore-scripts\n      - name: Prepare release\n        env:\n          GH_TOKEN: ${{ github.token }}\n        run: |\n          set -euo pipefail\n          TAG=\"v$(node -p \"require('./package.json').version\")\"\n          printf 'TAG=%s\\n' \"$TAG\" >> \"$GITHUB_ENV\"\n          git fetch origin \"refs/tags/$TAG:refs/tags/$TAG\"\n          gh api --paginate \"repos/$GITHUB_REPOSITORY/releases\" --jq '.[].tag_name' > \"$RUNNER_TEMP/release-tags\"\n          if grep -Fxq \"$TAG\" \"$RUNNER_TEMP/release-tags\"; then\n            printf 'RELEASE %s · exists\\n' \"$TAG\"\n          else\n            gh release create \"$TAG\" --verify-tag --draft --title \"$TAG\" --generate-notes\n            printf 'RELEASE %s · draft created · awaiting signed assets\\n' \"$TAG\"\n          fi\n      - name: Read owner approval\n        env:\n          GH_TOKEN: ${{ github.token }}\n        run: |\n          set -euo pipefail\n          mkdir .release\n          gh release download \"$TAG\" --pattern approval-signed --dir .release\n          node .instrument/node_modules/@lapxo/bound/dist/cli/verb.js fold --as release .release/approval-signed > .release/verdict\n          cat .release/verdict\n      - name: Stage the approved release archive\n        env:\n          GH_TOKEN: ${{ github.token }}\n        run: |\n          set -euo pipefail\n          read -r status digest archive source extra < .release/verdict\n          test \"$status\" = READY\n          test -z \"$extra\"\n          gh release download \"$TAG\" --pattern \"$archive\" --dir .release\n          printf '%s  %s\\n' \"${digest#sha256:}\" \".release/$archive\" | sha256sum -c -\n          expected=\"$(node -p \"require('./package.json').name+'@'+require('./package.json').version\")\"\n          actual=\"$(tar -xOf \".release/$archive\" package/package.json | node -p \"const p=JSON.parse(require('fs').readFileSync(0,'utf8'));p.name+'@'+p.version\")\"\n          test \"$actual\" = \"$expected\"\n          printf 'SOURCE release/%s/%s · %s · declared %s\\n' \"$TAG\" \"$archive\" \"$digest\" \"$source\"\n          gh release edit \"$TAG\" --draft=false\n          printf 'RELEASE %s · published · %s\\n' \"$TAG\" \"$digest\"\n          npm stage publish \".release/$archive\" --access public --ignore-scripts\n          printf 'STAGED %s · %s · owner approval pending\\n' \"$actual\" \"$digest\"\n" at=policy:mathematical-verification by=owner epoch=4 form=alphabet measure=text role=writes scope=prose/en/pipeline/release shape=.github/workflows/release.yml sig="ed25519:era1:kdEFlvkFnzBm2BQfFtIVGDOJv5kXrv4lXvNwUTvwGe/2UAnZ7I/v4rgnCCouDJ25BenHylDcjYKZStUhumqbDA==" value=lock
bound-lock/1 about="name: tag\non:\n  workflow_run:\n    workflows: [test]\n    types: [completed]\njobs:\n  tag:\n    if: github.event.workflow_run.conclusion == 'success' && github.event.workflow_run.event == 'push' && github.event.workflow_run.head_branch == 'main'\n    runs-on: ubuntu-latest\n    permissions:\n      contents: write\n    steps:\n      - uses: actions/checkout@v4\n        with:\n          ref: ${{ github.event.workflow_run.head_sha }}\n          fetch-depth: 0\n      - run: |\n          version=\"v$(node -p \"require('./package.json').version\")\"\n          git tag --list \"$version\" | grep -q . && exit 0\n          git tag \"$version\" && git push origin \"$version\"\n" at=policy:mathematical-verification by=owner epoch=4 form=alphabet measure=text role=writes scope=prose/en/pipeline/tag shape=.github/workflows/tag.yml sig="ed25519:era1:EnrHFdswug38bTRE19j02UyZjZttRe6qDmcqMBScqHuBQI9ZkaLEUAWIfrpMmsXSlXKC+5MgTwJ/V0n8qa0wBQ==" value=lock
bound-lock/1 about="name: test\non:\n  push:\n    branches: [main]\n  pull_request:\npermissions:\n  contents: read\njobs:\n  test:\n    strategy:\n      matrix:\n        node: [22, 24]\n    runs-on: ubuntu-24.04\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/setup-node@v4\n        with:\n          node-version: ${{ matrix.node }}\n      - run: npm ci --ignore-scripts\n      - run: npm run build\n      - name: Install pinned Elan\n        run: |\n          set -euo pipefail\n          curl --fail --location --proto '=https' --proto-redir '=https' https://github.com/leanprover/elan/releases/download/v4.2.4/elan-x86_64-unknown-linux-gnu.tar.gz --output \"$RUNNER_TEMP/elan.tar.gz\"\n          printf '%s  %s\\n' 42b94d4244e8353142c456ec0e4ca6528fd898a6c604d4059f494e706e431f63 \"$RUNNER_TEMP/elan.tar.gz\" | sha256sum --check\n          mkdir \"$RUNNER_TEMP/elan-installer\"\n          tar -xzf \"$RUNNER_TEMP/elan.tar.gz\" -C \"$RUNNER_TEMP/elan-installer\"\n          \"$RUNNER_TEMP/elan-installer/elan-init\" -y --default-toolchain none\n          printf '%s\\n' \"$HOME/.elan/bin\" >> \"$GITHUB_PATH\"\n      - uses: actions/cache@v4\n        with:\n          path: |\n            ~/.elan/toolchains\n            proofs/lean/.lake\n          key: lean-${{ runner.os }}-${{ runner.arch }}-${{ hashFiles('proofs/lean/lean-toolchain', 'proofs/lean/lakefile.toml', 'proofs/lean/lake-manifest.json') }}-${{ hashFiles('proofs/lean/**/*.lean') }}\n          restore-keys: lean-${{ runner.os }}-${{ runner.arch }}-${{ hashFiles('proofs/lean/lean-toolchain', 'proofs/lean/lakefile.toml', 'proofs/lean/lake-manifest.json') }}-\n      - name: Prepare pinned proof dependencies\n        working-directory: proofs/lean\n        run: |\n          set -euo pipefail\n          elan toolchain install \"$(cat lean-toolchain)\"\n          lean --version\n          lake exe cache get\n          mkdir -p .lake/build/lib/lean\n          printf 'OBLIGATIONS_LEAN=%s/bin/lean\\n' \"$(lean --print-prefix)\" >> \"$GITHUB_ENV\"\n          printf 'OBLIGATIONS_LEAN_DEPENDENCIES=%s\\n' \"$(lake env printenv LEAN_PATH)\" >> \"$GITHUB_ENV\"\n      - name: Install the verification instrument\n        run: npm install --prefix \"$RUNNER_TEMP/obligations-instrument\" --no-save --ignore-scripts @lapxo/bound@0.2.6\n      - name: Admit signed mathematical declarations\n        run: |\n          set -euo pipefail\n          mkdir -p .bound/cas/blobs\n          cp verification/readers/* .bound/cas/blobs/\n          node \"$RUNNER_TEMP/obligations-instrument/node_modules/@lapxo/bound/dist/cli/verb.js\" land TARGET.bound\n      - name: Verify mathematical obligations and retain receipts\n        run: |\n          set -euo pipefail\n          node \"$RUNNER_TEMP/obligations-instrument/node_modules/@lapxo/bound/dist/cli/verb.js\" fold\n          node \"$RUNNER_TEMP/obligations-instrument/node_modules/@lapxo/bound/dist/cli/verb.js\" fold --check\n      - uses: actions/upload-artifact@v4\n        if: always()\n        with:\n          name: mathematical-receipts-node-${{ matrix.node }}\n          path: receipts.bound\n          if-no-files-found: error\n" at=policy:mathematical-verification by=owner epoch=4 form=alphabet measure=text role=writes scope=prose/en/pipeline/test shape=.github/workflows/test.yml sig="ed25519:era1:SRmKflSgK3D65JWVUaN0ybigy0JHIDr6lT3fsSPfl19em+m4ESoO8dhL6tmDxRo7JRIU7p2l+fABEz6jL7vJCg==" value=lock
