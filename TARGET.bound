bound-lock/1 about="name: release\non:\n  workflow_run:\n    workflows: [tag]\n    types: [completed]\n  workflow_dispatch:\njobs:\n  stage:\n    if: github.event_name == 'workflow_dispatch' || (github.event.workflow_run.conclusion == 'success' && github.event.workflow_run.head_branch == 'main')\n    concurrency: release-delivery\n    environment: release\n    runs-on: ubuntu-latest\n    permissions:\n      contents: write\n      id-token: write\n    steps:\n      - uses: actions/checkout@v4\n        with:\n          ref: ${{ github.event.workflow_run.head_sha || github.sha }}\n      - uses: actions/setup-node@v4\n        with:\n          node-version: 24\n      - run: npm install --prefix .instrument --no-save --ignore-scripts @lapxo/bound@0.2.1\n      - run: npm install --global npm@'12.1.0' --ignore-scripts\n      - name: Prepare release\n        env:\n          GH_TOKEN: ${{ github.token }}\n        run: |\n          set -euo pipefail\n          TAG=\"v$(node -p \"require('./package.json').version\")\"\n          printf 'TAG=%s\\n' \"$TAG\" >> \"$GITHUB_ENV\"\n          git fetch origin \"refs/tags/$TAG:refs/tags/$TAG\"\n          gh api --paginate \"repos/$GITHUB_REPOSITORY/releases\" --jq '.[].tag_name' > \"$RUNNER_TEMP/release-tags\"\n          if grep -Fxq \"$TAG\" \"$RUNNER_TEMP/release-tags\"; then\n            printf 'RELEASE %s · exists\\n' \"$TAG\"\n          else\n            gh release create \"$TAG\" --verify-tag --draft --title \"$TAG\" --generate-notes\n            printf 'RELEASE %s · draft created · awaiting signed assets\\n' \"$TAG\"\n          fi\n      - name: Read owner approval\n        env:\n          GH_TOKEN: ${{ github.token }}\n        run: |\n          set -euo pipefail\n          mkdir .release\n          gh release download \"$TAG\" --pattern approval-signed --dir .release\n          node .instrument/node_modules/@lapxo/bound/dist/cli/verb.js fold --as release .release/approval-signed > .release/verdict\n          cat .release/verdict\n      - name: Stage the approved release archive\n        env:\n          GH_TOKEN: ${{ github.token }}\n        run: |\n          set -euo pipefail\n          read -r status digest archive source extra < .release/verdict\n          test \"$status\" = READY\n          test -z \"$extra\"\n          gh release download \"$TAG\" --pattern \"$archive\" --dir .release\n          printf '%s  %s\\n' \"${digest#sha256:}\" \".release/$archive\" | sha256sum -c -\n          expected=\"$(node -p \"require('./package.json').name+'@'+require('./package.json').version\")\"\n          actual=\"$(tar -xOf \".release/$archive\" package/package.json | node -p \"const p=JSON.parse(require('fs').readFileSync(0,'utf8'));p.name+'@'+p.version\")\"\n          test \"$actual\" = \"$expected\"\n          printf 'SOURCE release/%s/%s · %s · declared %s\\n' \"$TAG\" \"$archive\" \"$digest\" \"$source\"\n          gh release edit \"$TAG\" --draft=false\n          printf 'RELEASE %s · published · %s\\n' \"$TAG\" \"$digest\"\n          npm stage publish \".release/$archive\" --access public --ignore-scripts\n          printf 'STAGED %s · %s · owner approval pending\\n' \"$actual\" \"$digest\"\n" at=witness:043/native-closure by=target form=alphabet measure=text role=writes scope=prose/en/pipeline/approved-delivery shape=.github/workflows/release.yml value=lock
bound-lock/1 about="name: tag\non:\n  workflow_run:\n    workflows: [test]\n    types: [completed]\njobs:\n  tag:\n    if: github.event.workflow_run.conclusion == 'success' && github.event.workflow_run.event == 'push' && github.event.workflow_run.head_branch == 'main'\n    runs-on: ubuntu-latest\n    permissions:\n      contents: write\n    steps:\n      - uses: actions/checkout@v4\n        with:\n          ref: ${{ github.event.workflow_run.head_sha }}\n          fetch-depth: 0\n      - run: |\n          version=\"v$(node -p \"require('./package.json').version\")\"\n          git tag --list \"$version\" | grep -q . && exit 0\n          git tag \"$version\" && git push origin \"$version\"\n" at=witness:043/native-closure by=target form=alphabet measure=text role=writes scope=prose/en/pipeline/checked-tag shape=.github/workflows/tag.yml value=lock
bound-lock/1 about="name: test\njobs:\n  test:\n    strategy:\n      matrix:\n        node:\n        - 22\n        - 24\n    runs-on: ubuntu-latest\n    permissions:\n      contents: write\n    steps:\n    - uses: actions/checkout@v4\n    - uses: actions/setup-node@v4\n      with:\n        node-version: ${{ matrix.node }}\n    - run: npm ci\n    - run: npm run build\n    - run: npm test\n    - name: Lay the declared historical proof reader\n      env:\n        GH_TOKEN: ${{ github.token }}\n      run: |\n        set -euo pipefail\n        mkdir -p .bound/cas/blobs\n        gh release download \"v0.4.4\" --pattern 5399fdc87cb104b5030e092e213ad6584004c6d4de49e716838081ae1f2e4182 --pattern 8655c52a0a4f6e19c883f2fe50b8f34eaa2cee7b21ac14b635a1a70130ab45fd --dir .bound/cas/blobs\n    - run: npm exec --yes --package=@lapxo/bound@0.2.1 --package=@lapxo/topos@0.2.0 -- bound fold --check\n  lean:\n    runs-on: ubuntu-24.04\n    permissions:\n      contents: write\n    defaults:\n      run:\n        shell: bash\n        working-directory: proofs/lean\n    steps:\n    - uses: actions/checkout@v4\n    - name: Install pinned Elan\n      shell: bash\n      run: |\n        set -euo pipefail\n        curl --fail --location --proto '=https' --proto-redir '=https' https://github.com/leanprover/elan/releases/download/v4.2.4/elan-x86_64-unknown-linux-gnu.tar.gz --output \"$RUNNER_TEMP/elan.tar.gz\"\n        printf '%s  %s\\n' 42b94d4244e8353142c456ec0e4ca6528fd898a6c604d4059f494e706e431f63 \"$RUNNER_TEMP/elan.tar.gz\" | sha256sum --check\n        mkdir \"$RUNNER_TEMP/elan-installer\"\n        tar -xzf \"$RUNNER_TEMP/elan.tar.gz\" -C \"$RUNNER_TEMP/elan-installer\"\n        \"$RUNNER_TEMP/elan-installer/elan-init\" -y --default-toolchain none\n        printf '%s\\n' \"$HOME/.elan/bin\" >> \"$GITHUB_PATH\"\n    - uses: actions/cache@v4\n      with:\n        path: |-\n          ~/.elan/toolchains\n          proofs/lean/.lake\n        key: lean-${{ runner.os }}-${{ runner.arch }}-${{ hashFiles('proofs/lean/lean-toolchain', 'proofs/lean/lakefile.toml', 'proofs/lean/lake-manifest.json') }}-${{\n          hashFiles('proofs/lean/**/*.lean') }}\n        restore-keys: lean-${{ runner.os }}-${{ runner.arch }}-${{ hashFiles('proofs/lean/lean-toolchain', 'proofs/lean/lakefile.toml', 'proofs/lean/lake-manifest.json')\n          }}-\n    - uses: actions/setup-node@v4\n      with:\n        node-version: 24\n    - name: Prepare locked compiler image\n      run: |\n        set -euo pipefail\n        elan toolchain install \"$(cat lean-toolchain)\"\n        lean --version\n        lake exe cache get Mathlib.Order.Interval.Set.Basic\n    - name: Install the published instrument\n      working-directory: .\n      run: npm install --prefix \"$RUNNER_TEMP/lean-instrument\" --no-save --ignore-scripts @lapxo/bound@0.2.1 @lapxo/topos@0.2.0\n    - name: Lay the declared proof reader\n      working-directory: .\n      env:\n        GH_TOKEN: ${{ github.token }}\n      run: |\n        set -euo pipefail\n        mkdir -p \"$RUNNER_TEMP/lean-place/.bound/cas/blobs\"\n        git archive HEAD proofs/lean vectors/laws/meet-semilattice.json vectors/laws/helly-comb.lean.json | tar -x -C \"$RUNNER_TEMP/lean-place\"\n        cp proofs/lean/verification.bound \"$RUNNER_TEMP/lean-place/TARGET.bound\"\n        mkdir -p \"$RUNNER_TEMP/lean-place/proofs/lean/.lake\"\n        ln -s \"$GITHUB_WORKSPACE/proofs/lean/.lake/packages\" \"$RUNNER_TEMP/lean-place/proofs/lean/.lake/packages\"\n        gh release download \"v0.4.4\" --pattern 1b71c00ce6134659534532519d7139cc5576283b4a5bf1dc83327a3511e555e1 --pattern 0b40747e9fa2ac40c706220732c45870321230f3c5164153b428d7fa0273dd43 --dir \"$RUNNER_TEMP/lean-place/.bound/cas/blobs\"\n    - name: Fold proof inputs and check receipt reuse\n      working-directory: .\n      run: |\n        set -euo pipefail\n        node \"$RUNNER_TEMP/lean-instrument/node_modules/@lapxo/bound/dist/cli/verb.js\" land \"$RUNNER_TEMP/lean-place\"\n        node \"$RUNNER_TEMP/lean-instrument/node_modules/@lapxo/bound/dist/cli/verb.js\" fold \"$RUNNER_TEMP/lean-place\"\n        node \"$RUNNER_TEMP/lean-instrument/node_modules/@lapxo/bound/dist/cli/verb.js\" fold \"$RUNNER_TEMP/lean-place\" --check\n'on':\n  push:\n    branches:\n    - main\n  pull_request: null\n" at=witness:045/historical-proof-download by=target form=alphabet measure=text role=writes scope=prose/en/pipeline/proof-checks shape=.github/workflows/test.yml value=lock
