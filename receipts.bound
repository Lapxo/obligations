bound-lock/1 at=place:sha256:333d055462c818c9aad0496da7e5430cea069d49543f4b948c653e5a1197fb56 by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=about|brief|cases
bound-lock/1 at=place:sha256:333d055462c818c9aad0496da7e5430cea069d49543f4b948c653e5a1197fb56 by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/about value="The falsifier: an encounter between two origins with nothing they both reach. Then information would appear where nothing was shared."
bound-lock/1 at=place:sha256:333d055462c818c9aad0496da7e5430cea069d49543f4b948c653e5a1197fb56 by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/brief value="two origins meet with nothing they both reach"
bound-lock/1 at=place:sha256:3471498ef9b24b235061944301a40f4c9b9fa718ba2e050a89e1692b827d84ff by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=cases
bound-lock/1 at=place:sha256:3508de08235c3080a6685790658e5c27b1276c7767641d4578e6cac45ebc6d63 by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=about|cases
bound-lock/1 at=place:sha256:3508de08235c3080a6685790658e5c27b1276c7767641d4578e6cac45ebc6d63 by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/about value="One coordinate on a scale of a hundred and five levels carries the whole quantum story in four fields of a line.\nSuperposed it holds six point seven bits; two claims that meet at one level make it definite; a ceiling under that floor makes it forbidden, not narrow.\nAnd a second coordinate resting on the bound that moved narrows to five point four bits without anyone measuring it.\nPreparation and measurement on one coordinate of two hundred and fifty-six levels: free at eight bits, and five bits once two claims in phase leave it between a hundred and a hundred and thirty-one.\nAsking for the wide ceiling again leaves it where the narrow one put it. That is what irreversible means here, and it is the same fact as a signature being a meet."
