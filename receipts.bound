bound-lock/1 at=place:sha256:c776e1efdcb23a2c19f692e1b49300d4779027f953ad1c4e581c2ca2162c9304 by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=brief|cases|title
bound-lock/1 at=place:sha256:c776e1efdcb23a2c19f692e1b49300d4779027f953ad1c4e581c2ca2162c9304 by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/brief value="a cell cannot be both arbitrarily fine and arbitrarily well seen"
bound-lock/1 at=place:sha256:c776e1efdcb23a2c19f692e1b49300d4779027f953ad1c4e581c2ca2162c9304 by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/title value=Uncertainty
bound-lock/1 at=place:sha256:c88ba606e79dff4cbcf7290d8e970637260be8046680dba48f35b298f614383c by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=about|cases
bound-lock/1 at=place:sha256:c88ba606e79dff4cbcf7290d8e970637260be8046680dba48f35b298f614383c by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/about value="A rest tree of a hundred thousand cells, some signed below their bound; the root signed at a hundred.\nSigned again at a hundred it is absorbed; lighter it bites what it lowers and stops where it is absorbed; heavy it bites most of the tree."
bound-lock/1 at=place:sha256:c96445a83de3aa414160cabbcf5db3ad34a2876a104806782411d4cb33cfb8bd by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=about|cases
bound-lock/1 at=place:sha256:c96445a83de3aa414160cabbcf5db3ad34a2876a104806782411d4cb33cfb8bd by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/about value="A policy is four weights and nothing else: what a cell is worth to look at next is its reach, how together its claims arrived, what stands beside it and what it still leaves free.\nOver one field, four specialists and one mixed policy: the two that weigh only reach or only what stands beside a cell pile on a single cell and close nothing; the two that weigh width or coherence close almost everything.\nThe mixed policy closes more than any specialist and forks fewer times than either of the ones that close, which is the whole claim: four weights beat one, and the relation is the law while the counts belong to whoever reproduces them."
bound-lock/1 at=place:sha256:c979394ee8b2e770b62e8349262f4a9c8f6cf932fa8209a57a19a2a7b8dba035 by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=about|cases
bound-lock/1 at=place:sha256:c979394ee8b2e770b62e8349262f4a9c8f6cf932fa8209a57a19a2a7b8dba035 by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/about value="What would break T100, run against the object."
bound-lock/1 at=place:sha256:cc741981b39e28c788b0ac2589bfa661ab6367cc44b58a23551e1ea708b32606 by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=about|cases|coverage
bound-lock/1 at=place:sha256:cc741981b39e28c788b0ac2589bfa661ab6367cc44b58a23551e1ea708b32606 by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/about value="touches is rank equality. holds is the counterfactual.\nA twin of a binding claim touches and does not hold.\nThat is the disagreement; both answers are named."
bound-lock/1 at=place:sha256:cc8ae7302722d7ff6ada7c5081b337b721df21d4cb3bc2c9d5d32443261c8cb2 by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=cases
bound-lock/1 at=place:sha256:cd7973f5a57909ecc2495cdfbec954d80994012514cd1c3468bdb381cc1af4bd by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=about|cases|coverage
bound-lock/1 at=place:sha256:cd7973f5a57909ecc2495cdfbec954d80994012514cd1c3468bdb381cc1af4bd by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/about value="A boolean is exact in two places on a five-level chain and nowhere\nelse. That is the figure that earns the debit its place: two poles,\nnot one bit. `asBoolean` is the control, not a conversion utility.\n\nThe trap: an implementation that only counted well-formed units\n(floor ≤ ceiling) would report 15 possibles and hide the ten\ncontradictions a boolean cannot speak. The sweep is every pair."
