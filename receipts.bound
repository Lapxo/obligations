bound-lock/1 at=place:sha256:9dae1e68251fef17d85d51adbd3a32b3b542b0b67d6b5cb0dd7f38b0e61dee0e by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=about|cases
bound-lock/1 at=place:sha256:9dae1e68251fef17d85d51adbd3a32b3b542b0b67d6b5cb0dd7f38b0e61dee0e by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/about value="thm-dep: the conflict on a product is discounted by dependence and never inflated; the premium is inflated and never by more.\nThe lower end is reached with everything demanded and nothing permitted, the upper premium end at the crossed declaration.\nBoth bounds are checked at all sixteen declarations."
bound-lock/1 at=place:sha256:9e725a427ab656df45d3228cda58b49b7789c737a3c460d794e2fca569837e89 by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=cases
bound-lock/1 at=place:sha256:9e83c11e13d3e1690039e662eaec3e313f314d6823bf29e3342273cf6854b275 by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=expected.ok|folds|landed|region|verdict|why|witness
bound-lock/1 at=place:sha256:9f4ca943e1e389c6396992d30a3012b337696fbe00a41132c247a6ef12110af9 by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=about|cases
bound-lock/1 at=place:sha256:9f4ca943e1e389c6396992d30a3012b337696fbe00a41132c247a6ef12110af9 by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/about value="To own a claim is to be the origin of it and nothing else: the cell holds what each origin said, and taking an origin away takes exactly what it said and no more.\nThree origins on a cell; drop one and the meet widens by what that one had narrowed; drop another and it widens again."
bound-lock/1 at=place:sha256:9f537f554f14fc52ae7f5b0e3fcd3d4d070c73aad38b8c247114b0efcf651fa4 by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=cases|chain|coverage|family|note
bound-lock/1 at=place:sha256:a155fc8d4948289f5159fc231d1d4634ea89c09b4cef3a406a0860d167c40d00 by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=about|cases|coverage
bound-lock/1 at=place:sha256:a155fc8d4948289f5159fc231d1d4634ea89c09b4cef3a406a0860d167c40d00 by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/about value="A declared level is attainable. A name in a numeric gap is a hole.\nAsking for space-4 where the scale jumps 3 → 5 is not the same as asking out of range."
bound-lock/1 at=place:sha256:a3558c718214da5cb1869cd9b97944ff9fc38fb5fe3c1bfb57367de1c609c217 by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=about|cases|coverage|witness
bound-lock/1 at=place:sha256:a3558c718214da5cb1869cd9b97944ff9fc38fb5fe3c1bfb57367de1c609c217 by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/about value="A formula is a lock: the form, its operation and its inputs fix the value, and no code holds it. Two\ndeclarations of one formula are one value wherever they are folded."
bound-lock/1 at=place:sha256:a42ddcb2d07e26acfde072df1f2c8250c616daeed7958324d6d7a163d31b1630 by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=about|cases|chain|coverage|walked
bound-lock/1 at=place:sha256:a42ddcb2d07e26acfde072df1f2c8250c616daeed7958324d6d7a163d31b1630 by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/about value="What a viewpoint effectively holds: everything it can reach, all at\nonce.\n\nReaching means holding. A viewpoint that reaches another carries both\nsets of statements, so they combine — and the result can cross when\nneither side crosses alone. Checking viewpoints one at a time cannot\nfind that.\n\n`held` maps a name to the statement it carries directly; a name with\nno entry carries nothing and contributes nothing. `bounds` is null\nwhen the whole reach carries nothing at all.\n\nThe `escalates` case is the point of the file. Both `a` and `b` are\nsatisfiable alone and their combination is not."
bound-lock/1 at=place:sha256:a536102debfe9c43b888118d20acb8323d4414cc6644e9f9771a4de3fa06161e by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=about|cases
bound-lock/1 at=place:sha256:a536102debfe9c43b888118d20acb8323d4414cc6644e9f9771a4de3fa06161e by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/about value="A tree is not read leaf by leaf. What the lock names are regions, and the leaves are what a region happens to hold today: on this tree the reading lines name a few hundred regions while the readers observed thousands of leaves, about eight leaves to a region.\nSo the unit of observation is the region and the number of leaves is a consequence, which is why a tree that grows a thousand files does not grow a thousand questions."
