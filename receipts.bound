bound-lock/1 at=place:sha256:84d51cf89ab9bab6600789bb002cbdae915d695a129a338b1f87f80840b76340 by=reader:76e1db421edb form=alphabet measure=params role=reads scope=source/returns/fromScale value="(c: Scale)"
bound-lock/1 at=place:sha256:84d51cf89ab9bab6600789bb002cbdae915d695a129a338b1f87f80840b76340 by=reader:76e1db421edb form=alphabet measure=params role=reads scope=source/returns/subsets value="(tokens: readonly string[])"
bound-lock/1 at=place:sha256:84d51cf89ab9bab6600789bb002cbdae915d695a129a338b1f87f80840b76340 by=reader:76e1db421edb form=alphabet measure=text role=reads scope=source/head value="\n * Bands on a scale form a lattice: the meet is where two bands agree, the join is the smallest band that holds both.\n * The bottom is the band no value can stand in; joining it changes nothing.\n "
