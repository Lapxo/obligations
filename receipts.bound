bound-lock/1 at=place:sha256:2a2c06f32b79436543e4b24b6b1301ab2d21a38abeb26467d747413b436e2f27 by=reader:76e1db421edb form=alphabet measure=result role=reads scope=source/arrow/foldSigned value="{classes, standing, fork}"
bound-lock/1 at=place:sha256:2a2c06f32b79436543e4b24b6b1301ab2d21a38abeb26467d747413b436e2f27 by=reader:76e1db421edb form=alphabet measure=text role=reads scope=source/head value="\n * Signatures as meet: two signed values on one cell never replace each other. They relate by the cell's order —\n * equal values are one encounter, the narrower stands over the wider, and incomparable values all stand as a fork.\n "
