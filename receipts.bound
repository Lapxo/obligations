bound-lock/1 at=place:sha256:1d7bb8936718cfd4c80c3e2a94f4899feafb99898d6443c578d0196cf9133132 by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=about|cases|coverage|law|witness
bound-lock/1 at=place:sha256:1d7bb8936718cfd4c80c3e2a94f4899feafb99898d6443c578d0196cf9133132 by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/about value="Each origin holds a band of epochs; the present is the meet of the bands where origins agree, and a forward claim one origin makes is potential."
bound-lock/1 at=place:sha256:1fafef35e3bcea4dafa798d90116f8da85f6513966992e97daa809bf6b766630 by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=about|cases
bound-lock/1 at=place:sha256:1fafef35e3bcea4dafa798d90116f8da85f6513966992e97daa809bf6b766630 by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/about value="The origins of a cell are the vertices of a polygon, and what they hold together is its interior.\nTwo make an edge and no area; three an area; from four a vertex the others do not enclose is an outlier; from five the verdict has a centre, and taking any one origin away leaves it where it was.\nAs origins are added to one population the meet narrows toward consensus; two populations wearing one name never meet at any number of them."
bound-lock/1 at=place:sha256:228c664405a47a11731e4b1f0e36ddec79784ac22b4f8e8aea09c398c122f907 by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=about|cases|coverage|law
bound-lock/1 at=place:sha256:228c664405a47a11731e4b1f0e36ddec79784ac22b4f8e8aea09c398c122f907 by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/law/dangerous value=REQUIRED→CONFLICT|FREE→CONFLICT|FORBIDDEN→CONFLICT
bound-lock/1 at=place:sha256:228c664405a47a11731e4b1f0e36ddec79784ac22b4f8e8aea09c398c122f907 by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/moves value=FORBIDDEN→CONFLICT|FORBIDDEN→FREE|FREE→CONFLICT|FREE→FORBIDDEN|FREE→FREE|FREE→REQUIRED|REQUIRED→CONFLICT|REQUIRED→FREE
bound-lock/1 at=place:sha256:228c664405a47a11731e4b1f0e36ddec79784ac22b4f8e8aea09c398c122f907 by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/about value="The object's moves between its four states, one act at a time, on a cell resting on one bound.\nCONFLICT is reached two ways: locally, by claims that do not meet, and by signature, by a floor required past a signed ceiling or a ceiling signed under a required floor, whatever the claims hold.\nEvery move into CONFLICT is dangerous; every other is a cell becoming information, being taken back, closed or reopened."
bound-lock/1 at=place:sha256:228c664405a47a11731e4b1f0e36ddec79784ac22b4f8e8aea09c398c122f907 by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/law/why/FORBIDDEN→FREE value="a witnessed join reopened it"
bound-lock/1 at=place:sha256:228c664405a47a11731e4b1f0e36ddec79784ac22b4f8e8aea09c398c122f907 by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/law/why/FREE→FORBIDDEN value="a signature closed below what they hold"
bound-lock/1 at=place:sha256:228c664405a47a11731e4b1f0e36ddec79784ac22b4f8e8aea09c398c122f907 by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/law/why/FREE→REQUIRED value="a withdrawal took one back"
bound-lock/1 at=place:sha256:228c664405a47a11731e4b1f0e36ddec79784ac22b4f8e8aea09c398c122f907 by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/law/why/REQUIRED→FREE value="a second origin met the first"
