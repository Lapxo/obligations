bound-lock/1 at=place:sha256:7343064bad9117335f56cb3cbb29731c5220ca3435c73cfb397b13d8755e0327 by=reader:76e1db421edb form=interval measure=count role=reads scope=source/unread value=0..0
bound-lock/1 at=place:sha256:74dc6f5393af3779a189550f5115bce36bff1876890ce59e0cc41cc6bd5d2cc1 by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=about|cases
bound-lock/1 at=place:sha256:74dc6f5393af3779a189550f5115bce36bff1876890ce59e0cc41cc6bd5d2cc1 by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/about value="The drop is log2 of the ratio of states a second origin leaves standing.\nIt is a full bit exactly when that origin admits at most half of them, and nothing exactly when it narrows nothing.\nBetween the two there is a drop that is neither: fifteen of sixteen states costs 0.0931 of a bit."
bound-lock/1 at=place:sha256:75123b5840a208daa3d7b76cd5cce02c2a2a9432661e771860784e91fd639803 by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=about|cases|coverage|ladder|places|scales
bound-lock/1 at=place:sha256:75123b5840a208daa3d7b76cd5cce02c2a2a9432661e771860784e91fd639803 by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/about value="Every outcome a scale can produce under one way of valuing levels.\n\nJSON cannot hold a function, so the valuation is NAMED and every\nimplementation defines the same three by index:\n\n  counting   i\n  square     i * i\n  log        ln(i + 1)\n\nA ladder produces exactly one outcome — nothing — under all three.\nThe other scale does NOT always spread: under `counting` it collapses\nto one too. That asymmetry is the finding, and a file with only the\nsquare case would hide it.\n\nValues are rounded to 9 decimals before being counted as distinct."
bound-lock/1 at=place:sha256:779ca79bdbffe3cb9359d3e74d6d1f2df4308e9068135b7df47b2103e882c6af by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=cases
bound-lock/1 at=place:sha256:78cf8b8338182f2cd5ca9edcb0695f62caa8458692d55fec7a1b09a8b958f698 by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=about|cases|coverage|properties|scale
bound-lock/1 at=place:sha256:78cf8b8338182f2cd5ca9edcb0695f62caa8458692d55fec7a1b09a8b958f698 by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/about value="Combining must accept its own output.\n\n`compose` rejects a statement that was already impossible on its own — a\nfloor above its own ceiling is a typo, and calling it a collision hides\nit. That check is right at the front door and wrong everywhere else: it\nmade `compose` REFUSE ITS OWN RESULT the moment two statements collided.\n\nAn operation that cannot take its own output back is not closed, and\nwithout closure there is exactly one legal way to evaluate: a single pass\nover the original statements. No folding in a tree, no combining partial\nresults from shards, no merging replicas that were partitioned. The whole\nreason this arithmetic is worth having is that order does not matter, and\nan operation you can only apply left to right does not deliver that.\n\nSo `fuse` carries the law and `compose` is `fuse` plus an entry check.\nThe five properties below are the merge law of a conflict-free replicated\ntype, which is why a crossed result must survive rather than be resolved\naway: both sides were load-bearing, and a winner is not an answer."
bound-lock/1 at=place:sha256:79454c2d8765b0bdfa5121d3395d35d3b70d475ac607cb3bd02de2694119c30d by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=about|brief|cases|title
bound-lock/1 at=place:sha256:79454c2d8765b0bdfa5121d3395d35d3b70d475ac607cb3bd02de2694119c30d by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/about value="Stated as a conjecture about structure and never about arithmetic: amplitudes with phase and no origin, no signed ceiling, no resolution and no epoch band are what is left of a cell when those four fields are dropped.\nWhat can be measured is measured here. Four claims in phase against an environment spread over the period keep the coherence their share of the whole leaves them: one, then the signal over the total, down to three hundredths at a hundred and twenty-eight.\nAnd six origins around one value are six objects read finely and one read coarsely, so how many things there are is a reading and not a fact about the things."
bound-lock/1 at=place:sha256:79454c2d8765b0bdfa5121d3395d35d3b70d475ac607cb3bd02de2694119c30d by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/brief value="what is left of a cell when who, ceiling, resolution and band are dropped"
bound-lock/1 at=place:sha256:79454c2d8765b0bdfa5121d3395d35d3b70d475ac607cb3bd02de2694119c30d by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/title value="Amplitudes without an origin"
bound-lock/1 at=place:sha256:7a854006ecf9df4a318382a60016a5bfa357fdd13ec013ed69b7e94da0a92258 by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=cases
bound-lock/1 at=place:sha256:7abfaf90c4e8c4adc266b44fe73f86b2372a042a3447b2415b0445a9c8c8d389 by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=cases
bound-lock/1 at=place:sha256:7bc1d5e6e8045219f960841e4f85cbf910b369a320b85cddf769611d1fc561ea by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=about|cases|coverage|scales|sign
bound-lock/1 at=place:sha256:7bc1d5e6e8045219f960841e4f85cbf910b369a320b85cddf769611d1fc561ea by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/about value="How far combining reaches past each side.\n\nThese decide the sign of what is left over BEFORE anybody says what a\nlevel is worth. Both zero means nothing is left over, for any way of\nvaluing levels at all.\n\nA ladder has no slack anywhere, which is why every `chain` case here\nis (0, 0). The `powerset` cases are the point: the two levels that\nsit side by side are exactly where it shows.\n\n`null` means the scale cannot count steps between those levels."
bound-lock/1 at=place:sha256:7cb1aaa9281684deed28254a4dd99c80945dbdce48a96e6b2c8b108f117c845f by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=about|brief|cases|title
bound-lock/1 at=place:sha256:7cb1aaa9281684deed28254a4dd99c80945dbdce48a96e6b2c8b108f117c845f by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/about value="Stated as a conjecture: four instruments that share no physics fold the same way, because a measurement is a cell.\nFor each of them the five fields are named without strain, and the same five operations answer for all four.\nNo numbers are claimed here. What is claimed is that the table can be filled in every row, and a row that cannot be filled would end it."
bound-lock/1 at=place:sha256:7cb1aaa9281684deed28254a4dd99c80945dbdce48a96e6b2c8b108f117c845f by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/brief value="a thermometer, a survey, an interferometer and a headcount fill the same five fields"
bound-lock/1 at=place:sha256:7cb1aaa9281684deed28254a4dd99c80945dbdce48a96e6b2c8b108f117c845f by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/title value=Measurement
bound-lock/1 at=place:sha256:7d3f18081e810e8ae3197a343b66980e75c366bfbdb5f5e56a35525f5be5af54 by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=cases
bound-lock/1 at=place:sha256:7d56e0449bec71643929c7431922179199bf8700985abfdf5f290f60b5709c64 by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=cases
bound-lock/1 at=place:sha256:7e53312757d5e50b55bc4fbd0d3881bc4a482334cdc1438b74ab798670c67ed2 by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=about|cases|coverage|law|witness
bound-lock/1 at=place:sha256:7e53312757d5e50b55bc4fbd0d3881bc4a482334cdc1438b74ab798670c67ed2 by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/about value="A coordinate exists only where two origins emitted a point at the same coordinate, resolution and epoch; one origin makes it potential, none leaves it empty."
bound-lock/1 at=place:sha256:7f080390bb20267a839c3bb1c370cd26fb3ec11cb9a24b469b2e4c0823f07c46 by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=cases
bound-lock/1 at=place:sha256:82b748fc39f60687690af29b5fef72c5f8a2b476431381f020b46654f215ab78 by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=about|cases
bound-lock/1 at=place:sha256:82b748fc39f60687690af29b5fef72c5f8a2b476431381f020b46654f215ab78 by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/about value="Thirty cells in two clusters, each an interval as wide as the next; pairs meet or fork, the meets join cells into components, and the whole field is met to nothing."
