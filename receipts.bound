bound-lock/1 at=place:sha256:f04f72c41af11fcb0909e632d80cdb18642f61bd5aadc1dac72db2684e75050b by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=cases
bound-lock/1 at=place:sha256:f0b6ad35d1611bbd5a813f3e6244601b9fa7410651852ab824f6b3701b78966e by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=about|brief|cases|title
bound-lock/1 at=place:sha256:f0b6ad35d1611bbd5a813f3e6244601b9fa7410651852ab824f6b3701b78966e by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/about value="Seven parts make the obligatory, and taking any one away leaves an object already known: without origins a meet of the lattice, without rests a cell nothing reaches, without a ceiling the lattice itself, without an epoch a timeless set of claims, without resolution a flat map, without ids a log that cannot take back, without join a ceiling that only narrows."
bound-lock/1 at=place:sha256:f0b6ad35d1611bbd5a813f3e6244601b9fa7410651852ab824f6b3701b78966e by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/brief value="remove a part and a known object remains; add one and the four states break"
bound-lock/1 at=place:sha256:f0b6ad35d1611bbd5a813f3e6244601b9fa7410651852ab824f6b3701b78966e by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/title value=Maximal
