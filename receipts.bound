bound-lock/1 at=place:sha256:ac36abb78662a21f67be874226996357392c2025ce1a98d91c89ab91951f02b3 by=reader:76e1db421edb form=interval measure=count role=reads scope=source/unread value=0..0
bound-lock/1 at=place:sha256:ad028717256bea4a659a2455ea967008f5da6696277e7537f9776de2cdac92e4 by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=cases
bound-lock/1 at=place:sha256:ade30f04c2b229b76f1d511b7d059aae9e597afa45854e00532d0cc68f4dce99 by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=about|cases|coverage
bound-lock/1 at=place:sha256:ade30f04c2b229b76f1d511b7d059aae9e597afa45854e00532d0cc68f4dce99 by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/about value="A region is identified by its coordinates, structurally and in one order, so two folds of one region are one value\nwherever they are computed; a change folds again only the regions that contain it, one per resolution.\nInside a region one step may be any step and a run of steps any run; a region ending in either is the region before it."
bound-lock/1 at=place:sha256:ae08d343ddb911c5adb325cb233207a8bd017c73f640b49e41d872635e0f9eb6 by=reader:76e1db421edb form=alphabet measure=id role=reads scope=source/lang value=ts
bound-lock/1 at=place:sha256:ae08d343ddb911c5adb325cb233207a8bd017c73f640b49e41d872635e0f9eb6 by=reader:76e1db421edb form=alphabet measure=id role=reads scope=source/specifiers value=../debit/graph.ts|../debit/packed.ts|../debit/unit.ts|../lattice/forms.ts|../lattice/scale-lattice.ts|./product/polygon.ts|./product/mould.ts|./product/resolution.ts|./product/reach.ts|./product/design.ts
bound-lock/1 at=place:sha256:ae08d343ddb911c5adb325cb233207a8bd017c73f640b49e41d872635e0f9eb6 by=reader:76e1db421edb form=alphabet measure=text role=reads scope=source/answers value="how a region decomposes"
bound-lock/1 at=place:sha256:ae08d343ddb911c5adb325cb233207a8bd017c73f640b49e41d872635e0f9eb6 by=reader:76e1db421edb form=alphabet measure=text role=reads scope=source/head value="\n * A product of lattices: a region of many cells is the product of their scales, and a meet splits into blocks that do\n * not interact. It answers how a region decomposes: what can be read cell by cell, packed side by side, and priced\n * block by block.\n *\n * Which operation answers this view is read off the laws its vectors fix: the view an operation has is the view of\n * the laws that name the vectors it ran on, or of the definition it implements. An operation no law reaches keeps the\n * view it was given by hand, as drift. Nothing here is new algebra: every name is re-exported once.\n "
bound-lock/1 at=place:sha256:ae08d343ddb911c5adb325cb233207a8bd017c73f640b49e41d872635e0f9eb6 by=reader:76e1db421edb form=interval measure=count role=reads scope=source/customised value=0..0
bound-lock/1 at=place:sha256:ae08d343ddb911c5adb325cb233207a8bd017c73f640b49e41d872635e0f9eb6 by=reader:76e1db421edb form=interval measure=count role=reads scope=source/dynamic value=0..0
bound-lock/1 at=place:sha256:ae08d343ddb911c5adb325cb233207a8bd017c73f640b49e41d872635e0f9eb6 by=reader:76e1db421edb form=interval measure=count role=reads scope=source/lexed value=0..0
bound-lock/1 at=place:sha256:ae08d343ddb911c5adb325cb233207a8bd017c73f640b49e41d872635e0f9eb6 by=reader:76e1db421edb form=interval measure=count role=reads scope=source/lines value=21..21
bound-lock/1 at=place:sha256:ae08d343ddb911c5adb325cb233207a8bd017c73f640b49e41d872635e0f9eb6 by=reader:76e1db421edb form=interval measure=count role=reads scope=source/longest value=0..0
bound-lock/1 at=place:sha256:ae08d343ddb911c5adb325cb233207a8bd017c73f640b49e41d872635e0f9eb6 by=reader:76e1db421edb form=interval measure=count role=reads scope=source/unread value=0..0
bound-lock/1 at=place:sha256:ae4582209a604de9019c6a1e5a6feaa6210c15bf2ea9cdf33c1d4b3aea091a2f by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=cases
bound-lock/1 at=place:sha256:ae58a2bb6fb32b099542102d4364dadf3fb485ad4ad12d73f58acf05484654ad by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=about|cases
bound-lock/1 at=place:sha256:ae58a2bb6fb32b099542102d4364dadf3fb485ad4ad12d73f58acf05484654ad by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/about value="What a block of t places costs: t times the scale it hides.\nIt is never less than two for each place past the first, and it is exactly that only for one place and for two.\nRead off the partition lattice of t places, up to six."
bound-lock/1 at=place:sha256:aed5fd238de37332494a24f86ee8392e9dd515735d0de5df80da89c7ec52ad36 by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=about|cases
bound-lock/1 at=place:sha256:aed5fd238de37332494a24f86ee8392e9dd515735d0de5df80da89c7ec52ad36 by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/about value="A cell that folds itself observes each epoch a claim of width ten centred on its own meet, off by at most the spread. It narrows only when the offset cuts inside what it holds, so its freedom falls and settles toward log2(11 − 2s) from above, and it never conflicts because each claim is centred on what it already holds."
