bound-lock/1 at=place:sha256:2fad619a2c96358a26a4dc3044db8a4f2daf1996040764db377dc62ad8b0be50 by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=about|brief|cases
bound-lock/1 at=place:sha256:2fad619a2c96358a26a4dc3044db8a4f2daf1996040764db377dc62ad8b0be50 by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/about value="The falsifier: an instrument whose reading cannot be written as a floor and a ceiling held by an origin at an epoch and a resolution, without straining any of the five."
bound-lock/1 at=place:sha256:2fad619a2c96358a26a4dc3044db8a4f2daf1996040764db377dc62ad8b0be50 by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/brief value="one instrument cannot"
bound-lock/1 at=place:sha256:2fbd9578c4ff23d12f33eda6434d95d771146049464fa3dc159726851c99dc28 by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=about|cases
bound-lock/1 at=place:sha256:2fbd9578c4ff23d12f33eda6434d95d771146049464fa3dc159726851c99dc28 by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/about value="How knowing moves through a field is one number: the forks it opens against the closes it makes.\nThe same policy over the same field, with claims drawn near the meet, across it, or from two origins alone, separates into three regimes by that ratio: nothing, sixty to one, and a quarter.\nSo a field is not described by how much was looked at but by what the looking did, and the ratio tells the regimes apart by two orders of magnitude."
bound-lock/1 at=place:sha256:31307a4f8208b71e3acc88b3972ecce8e1ee164607ac66842c81efa448256688 by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=about|cases
bound-lock/1 at=place:sha256:31307a4f8208b71e3acc88b3972ecce8e1ee164607ac66842c81efa448256688 by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/about value="What would break T90, run against the object."
bound-lock/1 at=place:sha256:31d8cb68f85b3b0e93b3db37b088db5015f6da17b163c2eb4c4702015c7e798b by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=cases
bound-lock/1 at=place:sha256:31ff4e2ebe37d11517b75ec13cc82bef9c754a94bcc69272fadea817452e4edd by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=about|cases|coverage|scale
bound-lock/1 at=place:sha256:31ff4e2ebe37d11517b75ec13cc82bef9c754a94bcc69272fadea817452e4edd by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/about value="The ideal carrier. Vectors whose expected values are written by hand,\nnot taken from either head. The entry condition of BEP-0005.\n\nL0 is the law the set-algebra bank does not state: U is an up-set, D is\na down-set. Without it, L1–L9 pass on arbitrary subsets of Omega."
bound-lock/1 at=place:sha256:32069f36a250a288c0628ddcaaaa837b1a2b452d9f1953134cc49673385f95b4 by=reader:76e1db421edb form=alphabet measure=id role=reads scope=source/lang value=ts
bound-lock/1 at=place:sha256:32069f36a250a288c0628ddcaaaa837b1a2b452d9f1953134cc49673385f95b4 by=reader:76e1db421edb form=alphabet measure=id role=reads scope=source/specifiers value=../debit/shuffle.ts|../field/field.ts
bound-lock/1 at=place:sha256:32069f36a250a288c0628ddcaaaa837b1a2b452d9f1953134cc49673385f95b4 by=reader:76e1db421edb form=alphabet measure=text role=reads scope=source/answers value="what is lost and what is kept when a bound is read coarser"
bound-lock/1 at=place:sha256:32069f36a250a288c0628ddcaaaa837b1a2b452d9f1953134cc49673385f95b4 by=reader:76e1db421edb form=alphabet measure=text role=reads scope=source/head value="\n * The lattice read through a congruence: what a coarser resolution, a predicate or a reordering cannot tell apart is\n * one class. It answers what is lost and what is kept when a bound is read coarser: how many questions a body of\n * claims asks, and the coarsest reading that still moves a verdict.\n *\n * Which operation answers this view is read off the laws its vectors fix: the view an operation has is the view of\n * the laws that name the vectors it ran on, or of the definition it implements. An operation no law reaches keeps the\n * view it was given by hand, as drift. Nothing here is new algebra: every name is re-exported once.\n "
