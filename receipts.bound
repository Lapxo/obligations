bound-lock/1 at=place:sha256:d3a8e640f82d582963f102a625cbf99c0c88e924757a3113a76272a198876dad by=reader:76e1db421edb form=interval measure=count role=reads scope=source/unread value=0..0
bound-lock/1 at=place:sha256:d52c4f9c3f76bc58c509a752fc8eb83770ca47d3eb303e26f69a14fcfc649837 by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=about|brief|cases|title
bound-lock/1 at=place:sha256:d52c4f9c3f76bc58c509a752fc8eb83770ca47d3eb303e26f69a14fcfc649837 by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/about value="Stated as a hint and never as a claim about the world: if what is is a field of floors and ceilings, then a distant signature changes a cell whose own record never moved.\nThe cell holds one state in every one of two hundred trials and the verdict comes out both ways, so nothing stored at the cell explains the difference.\nWhat explains it is elsewhere, in the bound the cell rests on."
bound-lock/1 at=place:sha256:d52c4f9c3f76bc58c509a752fc8eb83770ca47d3eb303e26f69a14fcfc649837 by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/brief value="a hint, never a claim"
bound-lock/1 at=place:sha256:d52c4f9c3f76bc58c509a752fc8eb83770ca47d3eb303e26f69a14fcfc649837 by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/title value="A distant signature moves a cell that did not move"
bound-lock/1 at=place:sha256:d5673376344151ef0d9c8c744cdece6eb388036a6b3fed8efd598f0685ad682c by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=about|cases|counterexamples|coverage|halves
bound-lock/1 at=place:sha256:d5673376344151ef0d9c8c744cdece6eb388036a6b3fed8efd598f0685ad682c by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/about value="isSupermodular is half of the hypothesis that makes g vanish, and the\nimplication as it was written is false.\n\nThe comment read: \"RI <= 0 on every pair: then g == 0.\" On a total order\n{x OR y, x AND y} is {x, y}, so RI is identically zero for every valuation.\nThe predicate cannot say no where it is used.\n\nA vacuous predicate has no symptom. The only way to find one is to ask\nwhether it CAN disagree - which is what `vacuity.ts` does.\n\nThe missing half is monotonicity:\n\n  monotone AND supermodular  =>  g == 0\n\nNeither half suffices alone. Among monotone valuations the converse holds:\ng != 0 iff not supermodular.\n\n`pricesAnything` carries both halves. `isSupermodular` stays: it tests the\nraw RI condition, and on a total order RI really is identically zero."
bound-lock/1 at=place:sha256:d5730ccb0c8202b15c9baaec08ba5a640c306e7fece776abc3597b8aba4290b9 by=reader:76e1db421edb form=alphabet measure=id role=reads scope=source/lang value=ts
bound-lock/1 at=place:sha256:d5730ccb0c8202b15c9baaec08ba5a640c306e7fece776abc3597b8aba4290b9 by=reader:76e1db421edb form=alphabet measure=id role=reads scope=source/specifiers value=../debit/shuffle.ts|../field/motion.ts|../lattice/declaration.ts|../lattice/order.ts|../lattice/price/premium.ts|../lattice/price/quote.ts|../lattice/vacuity.ts|../field/frontier.ts|../field/yield.ts
bound-lock/1 at=place:sha256:d5730ccb0c8202b15c9baaec08ba5a640c306e7fece776abc3597b8aba4290b9 by=reader:76e1db421edb form=alphabet measure=text role=reads scope=source/answers value="what a bound is worth"
bound-lock/1 at=place:sha256:d5730ccb0c8202b15c9baaec08ba5a640c306e7fece776abc3597b8aba4290b9 by=reader:76e1db421edb form=alphabet measure=text role=reads scope=source/head value="\n * A valuation on the lattice: a number for every state, monotone. It answers what a bound is worth: what violating it\n * costs, what planning buys over retreating (the premium), and when planning buys nothing because the valuation is\n * supermodular.\n *\n * Which operation answers this view is read off the laws its vectors fix: the view an operation has is the view of\n * the laws that name the vectors it ran on, or of the definition it implements. An operation no law reaches keeps the\n * view it was given by hand, as drift. Nothing here is new algebra: every name is re-exported once.\n "
bound-lock/1 at=place:sha256:d5730ccb0c8202b15c9baaec08ba5a640c306e7fece776abc3597b8aba4290b9 by=reader:76e1db421edb form=interval measure=count role=reads scope=source/customised value=0..0
