bound-lock/1 at=place:sha256:4520465e99747f8d47c104350cf68ca88667eab43972d6a6dd8eeac9a7196747 by=reader:76e1db421edb form=interval measure=count role=reads scope=source/unread value=0..0
bound-lock/1 at=place:sha256:4541c100177b466daf6662bc26cb58baec04d5847406467814c236a741947ce6 by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=about|cases
bound-lock/1 at=place:sha256:4541c100177b466daf6662bc26cb58baec04d5847406467814c236a741947ce6 by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/about value="Cells that rest on one bound move together when it moves: narrowing a ceiling from a hundred to sixty turned cells red with nobody looking at them, some of them past the horizon of whoever signed it.\nThe effect is the bound's, not the order's: the same narrowing in two steps names exactly the same cells as in one.\nNo cell that does not rest on it moves, and no cell that rests on it and should move stays.\nWhat a signature reaches is its rank: the cells that rest on the bound it moves, counted before it is moved.\nOne ceiling ranks sixty-six of a hundred cells; an origin that looked at one cell ranks one. A signature is worth what rests on it and nothing else."
bound-lock/1 at=place:sha256:4821af774bb15faf880f47b9fb8fab185efb3559ce593a92133e4c507a9c37f9 by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=about|cases
bound-lock/1 at=place:sha256:4821af774bb15faf880f47b9fb8fab185efb3559ce593a92133e4c507a9c37f9 by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/about value="A world has two physics at once. Looking travels: it reaches what a walk of shared lookings reaches and stops at the horizon.\nA bound does not travel: it carries no step and no distance, and moving it changes cells past that horizon in one act.\nCounting the bound as if it were a looking would make the whole world one neighbourhood, which is how the two are told apart.\nThe two physics side by side, in one world of a hundred cells. Looking is local: it reaches seventy-three cells, one step at a time, stops at the horizon, and moves a floor.\nSigning is not: it reaches the sixty-six cells that rest on the bound, at no distance, past any horizon, and moves a ceiling. Seven of the cells it turned are cells no looking from the observer could have reached."
bound-lock/1 at=place:sha256:4898dac4a52307403796fb1e6c2f743fba47c4b922f26cf2a482d394f0ac7186 by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=cases
bound-lock/1 at=place:sha256:490d335ea161eedd02893f3dcb5334bfb72d953f5812d99b1685149d3bc081bf by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=about|cases
bound-lock/1 at=place:sha256:490d335ea161eedd02893f3dcb5334bfb72d953f5812d99b1685149d3bc081bf by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/about value="A field left to itself concentrates where it already is and keeps its deserts: under attachment the horizon falls slowly and does not close, in sixty epochs and in either draw.\nThe same budget spent each epoch where reach is greatest drives the horizon to zero in four epochs.\nThe machine that does it holds nothing and asserts nothing: it reads the field as it stands, answers which two islands to bridge, and is a cell of the field it weaves."
bound-lock/1 at=place:sha256:4a677415e27b0a6a59d144abe786b91a409ac1f9dc5ed40d9dd892722fdf742e by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=about|cases|coverage
bound-lock/1 at=place:sha256:4a677415e27b0a6a59d144abe786b91a409ac1f9dc5ed40d9dd892722fdf742e by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/about value="A verdict is a fold of what already exists, never code an instrument runs: a region is answered when everything\nthat moved lies inside it and no verified origin answers red. An origin never seen green is grey and binds nobody."
bound-lock/1 at=place:sha256:4d6d1e5da6f464e8288bf217219bdb8316c461ce4becbe51e73bd54f2de20b9e by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=about|cases
bound-lock/1 at=place:sha256:4d6d1e5da6f464e8288bf217219bdb8316c461ce4becbe51e73bd54f2de20b9e by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/about value="A cell grows until something stops it: a wall the lock names, or the place where the next origin's claim is nearer than its own.\nWhat stops it is never its own doing, so a cell alone between two walls is as wide as they leave it, and one that lands beside another takes the midpoint between them.\nAn origin landing beside a cell narrows that cell and never widens any."
bound-lock/1 at=place:sha256:4e3830ae2be95957b837993e66ad916795b30f8e53ac90e04076b45bcece5b29 by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=cases
