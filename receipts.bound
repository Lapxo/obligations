bound-lock/1 at=place:sha256:ac36abb78662a21f67be874226996357392c2025ce1a98d91c89ab91951f02b3 by=reader:76e1db421edb form=alphabet measure=id role=reads scope=source/specifiers value=../../field/meet.ts|../../field/observe.ts|../../lattice/obligatory.ts|../../lattice/lattice.ts
bound-lock/1 at=place:sha256:ac36abb78662a21f67be874226996357392c2025ce1a98d91c89ab91951f02b3 by=reader:76e1db421edb form=alphabet measure=named role=reads scope=source/range/selfFold value=613..677
bound-lock/1 at=place:sha256:ac36abb78662a21f67be874226996357392c2025ce1a98d91c89ab91951f02b3 by=reader:76e1db421edb form=alphabet measure=params role=reads scope=source/returns/selfFold value="(lattice: Lattice<Band>, one: Obligatory<Band>, epochs: number, width: number, spread: number, seed: number)"
bound-lock/1 at=place:sha256:ac36abb78662a21f67be874226996357392c2025ce1a98d91c89ab91951f02b3 by=reader:76e1db421edb form=alphabet measure=text role=reads scope=source/head value="\n * A cell that folds itself: each epoch it observes a claim of the given width centred on its own meet, off by at most\n * the spread. It narrows only when the offset cuts inside what it already holds, so its freedom settles instead of\n * vanishing, and it never conflicts, because every claim it makes is centred on what it holds.\n "
bound-lock/1 at=place:sha256:ac36abb78662a21f67be874226996357392c2025ce1a98d91c89ab91951f02b3 by=reader:76e1db421edb form=alphabet measure=text role=reads scope=source/signature/selfFold value="selfFold(lattice: Lattice<Band>, one: Obligatory<Band>, epochs: number, width: number, spread: number, seed: number): readonly Obligatory<Band>[]"
