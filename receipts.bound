bound-lock/1 at=place:sha256:c0d93c72af6a3d51ca8dff464f882004ffe1874e5a1e6f4c388e4cef7ed2eef8 by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=cases
bound-lock/1 at=place:sha256:c148b174b94eefa3c867846f488b993be7dddd9350ba0a1f1c1f1b1b7289d1fb by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=about|cases|coverage
bound-lock/1 at=place:sha256:c148b174b94eefa3c867846f488b993be7dddd9350ba0a1f1c1f1b1b7289d1fb by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/about value="Every form is a lattice, and its join is the smallest value that holds both demands: the band that spans two bands,\nthe tokens either alphabet allows, the hull of two intervals. The bottom is the value no demand can stand in, and\njoining it changes nothing."
bound-lock/1 at=place:sha256:c2164429ebda3566125dddf15d9368b2f26205c2c1023e2b3cf5dac7bdd32967 by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=about|cases
bound-lock/1 at=place:sha256:c2164429ebda3566125dddf15d9368b2f26205c2c1023e2b3cf5dac7bdd32967 by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/about value="Origins agree at a resolution. Read coarsely a claim is wide and three of them meet; read finely each is sharp and the meeting opens into a fork, at the coordinate the coarser scale held together.\nOne hundred cells, three origins apiece, their centres drawn a fifth of a scale apart, each speaking as sharply as the scale it is read at.\nThe residual figure stops changing where the reading is sufficient."
bound-lock/1 at=place:sha256:c2737f71306c97e61990f78350492b69c23d3a7ac559bf6c71b6c147c9d92c00 by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=about|cases
bound-lock/1 at=place:sha256:c2737f71306c97e61990f78350492b69c23d3a7ac559bf6c71b6c147c9d92c00 by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/about value="Two cells are one step apart when an origin looked at both, so a world is a graph of its lookings and distance is the walk between them.\nIt is a metric: zero on a cell against itself, symmetric, and never broken by a third cell.\nAcross a desert of cells no looking crosses there is no number at all — that is the horizon, and one claim that speaks at both sides collapses it."
bound-lock/1 at=place:sha256:c32e81fc784343ac11b6eb9a288b8a8b7933c5ef103309361896d543ac2562bb by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=cases
bound-lock/1 at=place:sha256:c394242b6980120af2976ef64fa52cebebd46250dc777ccd705866b09fb682cc by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=cases
bound-lock/1 at=place:sha256:c4d5a3c9954f927a7c7b9f78c058bf700ea85b0c4e22db14754b2e1936b8ecf5 by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=about|cases
bound-lock/1 at=place:sha256:c4d5a3c9954f927a7c7b9f78c058bf700ea85b0c4e22db14754b2e1936b8ecf5 by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/about value="A declaration is a family of demands and a family of limits; the audit examines one against one.\nIt reports the whole conflict for every monotone valuation exactly when the demand is itself demanded and one limit already meets it.\nWhere that fails, an up-set indicator perturbed by height under-reports."
bound-lock/1 at=place:sha256:c5055d0cd6655b70c201b242a269787c1b2e325fd962e3df4ccfeb7a96ca83e5 by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=about|cases|coverage
bound-lock/1 at=place:sha256:c5055d0cd6655b70c201b242a269787c1b2e325fd962e3df4ccfeb7a96ca83e5 by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/about value="Three local operations over coordinates, and no edge anywhere: within (a point refines a region), resolution (how\nfinely a place is named) and passes (the coordinate goes through this step). Exclusivity is what no other side\nreaches, and a region no point reaches contracts (L20) — vacuity read as geometry rather than run as a rule.\n\nThe three came from six definitions that had drifted: one counted a dot as a step and another did not, and one was\nnot refinement at all. With one definition and this vector, two acts that paid an unreachable region stopped\ncounting as facts."
