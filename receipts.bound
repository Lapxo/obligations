bound-lock/1 at=place:sha256:260437cdda99e92c5bbf17cb31eec16ccb819f176ecdbe8ea3b009ac512091b6 by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/law/why/REQUIRED→FREE value="retiring a writer"
