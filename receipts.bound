bound-lock/1 at=place:sha256:55ee71785bb42cceda0407ab19184cf745acb19816133989ffbc917f2973d168 by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=about|cases|coverage
bound-lock/1 at=place:sha256:55ee71785bb42cceda0407ab19184cf745acb19816133989ffbc917f2973d168 by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/about value="A claim states a state, never an action: folding the same state twice is folding it once, and an origin that\nsays the same thing again is still one origin. Anything whose second application differs from its first is not a state."
bound-lock/1 at=place:sha256:5671d8010ca4a5ab79cdc700d5b665dcef6b4de80e732c773741401463056343 by=reader:76e1db421edb form=alphabet measure=id role=reads scope=source/lang value=ts
bound-lock/1 at=place:sha256:5671d8010ca4a5ab79cdc700d5b665dcef6b4de80e732c773741401463056343 by=reader:76e1db421edb form=alphabet measure=id role=reads scope=source/specifiers value=./errors.ts|./order.ts|../debit/unit.ts|../debit/packed.ts|../debit/masks.ts|../debit/register.ts|../debit/vector.ts|../debit/provenance.ts|../debit/standing.ts|./declaration.ts|./lattice.ts|./forms.ts|../debit/debit.ts|../field/signatures.ts|../field/field.ts|../field/present.ts|../field/yield.ts|../field/frontier.ts|../field/motion.ts|./axioms.ts|./scale-lattice.ts|../debit/ideal.ts|../debit/graph.ts|./vacuity.ts|../debit/shuffle.ts|./types.ts|../field/encounter.ts|../replay.ts
bound-lock/1 at=place:sha256:5671d8010ca4a5ab79cdc700d5b665dcef6b4de80e732c773741401463056343 by=reader:76e1db421edb form=alphabet measure=text role=reads scope=source/head value="\n * The algebra entire, three theories in one library: the lattice (two-sided constraints with a price), the debit (states\n * on a scale) and the field (points with epoch and origins). Every operation is here for any consumer; a consumer that\n * wants one part asks for its subpath.\n "
bound-lock/1 at=place:sha256:5671d8010ca4a5ab79cdc700d5b665dcef6b4de80e732c773741401463056343 by=reader:76e1db421edb form=interval measure=count role=reads scope=source/customised value=0..0
