bound-lock/1 at=place:sha256:4fadf74e3825ac4d5b79368ab7bd496d937cb280ab5f85a4443ba94e6aa84ad0 by=reader:76e1db421edb form=interval measure=count role=reads scope=source/unread value=0..0
bound-lock/1 at=place:sha256:51e85b170285f92b41438738cda6396bf1f163d1547608ca2f41aeee1ce313d8 by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=about|cases
bound-lock/1 at=place:sha256:51e85b170285f92b41438738cda6396bf1f163d1547608ca2f41aeee1ce313d8 by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/about value="A lock is a mould. Stretch every ceiling by the same factor and what stays red was never the ceiling's doing: it is a cell whose own origins do not meet, and no ceiling can hold it at any width.\nPouring another world into a lock counts the places it bounds that the world reaches.\nUnder use a lock deforms: what the world touched closes toward what was seen there, and what nothing touched opens."
bound-lock/1 at=place:sha256:5218ecbdcdd865121263ad086bc01f02c542e65bec15646bbef6cd86194b6f1b by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=about|cases
bound-lock/1 at=place:sha256:5218ecbdcdd865121263ad086bc01f02c542e65bec15646bbef6cd86194b6f1b by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/about value="What would break T92, run against the object."
bound-lock/1 at=place:sha256:5392980ca2caf818cb44856549423f2dbe2314944b6a7b1e6c78215d6e131052 by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=about|cases
bound-lock/1 at=place:sha256:5392980ca2caf818cb44856549423f2dbe2314944b6a7b1e6c78215d6e131052 by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/about value="A withdrawal takes back a write and leaves everything else standing: the claim is still on the cell, the origin still spoke, and what changed is what the cell now means.\nTwo origins meet at five to nine; withdraw one and the cell has one origin and is grey again; the withdrawn claim is still there to read."
bound-lock/1 at=place:sha256:542bca36aec65ffe177e584dcbff34430674e3e7e678181c2ff9b0f6d3171ec0 by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=about|cases|chain|coverage|extremes
bound-lock/1 at=place:sha256:542bca36aec65ffe177e584dcbff34430674e3e7e678181c2ff9b0f6d3171ec0 by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/about value="How much a statement says: the steps it demands plus the steps it\nlimits. Nothing to do with whether it can be satisfied.\n\nThe two halves are DIFFERENT sets — on a ladder the demand side is\nevery level above the bottom and the limit side every level below\nthe top. An implementation that counted one twice would get the same\ntotal on a symmetric case and be wrong everywhere else, so the file\nincludes asymmetric ones.\n\nZero exactly at (bottom, top); maximal exactly at (top, bottom)."
