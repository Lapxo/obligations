bound-lock/1 at=place:sha256:26c4be30b3114cc1aff7803eec2c8553be636dabdf5bd88a3c18b0639b9bcb0e by=reader:76e1db421edb form=alphabet measure=params role=reads scope=source/returns/width value="(cell: Point)"
