bound-lock/1 at=place:sha256:ce55c4a2fb22e001a41cd7f6227ddbbbcda2ca675663c8a913cad4cd2423f3a7 by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=about|brief|cases
bound-lock/1 at=place:sha256:ce55c4a2fb22e001a41cd7f6227ddbbbcda2ca675663c8a913cad4cd2423f3a7 by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/about value="The falsifier: a cell read at four resolutions whose product of resolution and independent encounters comes out above the floor while the encounters fall away with the sharpening. A product that rises as the reading sharpens would say the floor is not a floor but an accident of how coarsely the cell was read."
bound-lock/1 at=place:sha256:ce55c4a2fb22e001a41cd7f6227ddbbbcda2ca675663c8a913cad4cd2423f3a7 by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/brief value="the product rises as reading sharpens"
bound-lock/1 at=place:sha256:d1ab37b21473fc13f0a404d8c6df5359602eb23b3574da08e45000ac6db189a1 by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=about|brief|cases
bound-lock/1 at=place:sha256:d1ab37b21473fc13f0a404d8c6df5359602eb23b3574da08e45000ac6db189a1 by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/about value="The falsifier: a reading of the field where a player can suspend the rule that two origins are needed, or where one claim is information. Then the referee would be outside the game."
bound-lock/1 at=place:sha256:d1ab37b21473fc13f0a404d8c6df5359602eb23b3574da08e45000ac6db189a1 by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/brief value="a player can suspend the rule that two origins are needed"
bound-lock/1 at=place:sha256:d226fb25dfcec821e872809a4196dad4507c237a92f0de47335cba89c43ee278 by=reader:95297fcf0823 form=alphabet measure=id role=reads scope=said/fields value=about|cases|coverage
bound-lock/1 at=place:sha256:d226fb25dfcec821e872809a4196dad4507c237a92f0de47335cba89c43ee278 by=reader:95297fcf0823 form=alphabet measure=text role=reads scope=said/about value="A render is a region read at a resolution: each point named with fewer steps, and what lands on one coarse coordinate\nfolded together. A reader asks for the resolution it needs, and nothing finer is carried."
