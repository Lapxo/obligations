bound-lock/1 about="a region no origin touches for an epoch contracts; nothing keeps a cell alive but a new observation" at=policy:law/A6 by=target form=alphabet kind=axiom measure=status needs=samples/yes/A6-vacuity.json|samples/no/A6-vacuity.json|vectors/field.json role=demands scope=law/A6-vacuity value=present view=field
