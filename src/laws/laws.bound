bound-lock/1 about="every quantity has two poles, a floor that is required and a ceiling that is permitted, and a cell is the pair" at=policy:law/A0 by=target form=alphabet kind=axiom measure=status needs=samples/yes/A0-carrier.json|samples/no/A0-carrier.json|vectors/closure.json role=demands scope=law/A0-carrier value=present view=lattice
