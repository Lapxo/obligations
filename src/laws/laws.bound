bound-lock/1 at=policy:law/formulas by=target form=formula measure=text role=writes scope=law/A7-freedom-conserved/formula value="F(C) = Σ_{c∈C} F(c),   F(a(c)) ≤ F(c) for every act a that narrows"
bound-lock/1 at=policy:law/formulas by=target form=formula measure=text role=writes scope=law/T49-amplitude-has-sign-and-phase/formula value="A(c) = |Σ_{o∈O} s_o w_o e^{iφ_o}|²"
bound-lock/1 at=policy:law/formulas by=target form=formula measure=text role=writes scope=law/T95-signatures-live-where-they-are-signed/formula value="For finite acyclic snapshots without widening: ceiling(c)=meet(live local ceiling marks, travelling ancestor ceiling marks, live local claim spans); one appended mark per sign/require, no depth-only runtime bound"
bound-lock/1 at=policy:law/formulas by=target form=formula measure=text role=writes scope=law/T87-the-quarter-turn/formula value="delta=acos(cos(a-b)) in [0,pi]; |exp(ia)+exp(ib)|^2=2+2*cos(delta); below 2 iff delta>pi/2"
