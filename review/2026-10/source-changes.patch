diff --git a/test/measures/confidence.test.ts b/test/measures/confidence.test.ts
new file mode 100644
index 0000000..1f25afc
--- /dev/null
+++ b/test/measures/confidence.test.ts
@@ -0,0 +1,31 @@
+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {unionBoundConfidence,type DeclaredFailure} from '../../src/measures/confidence.ts';
+const declaration=(id:string,p:string)=>({id,p,justification:`hypothesis:${id}`});
+test('T18 exact union-bound; no independence premise',()=>{
+  const failures=[declaration('A','1/10'),declaration('B','1/5')],before=JSON.stringify(failures);
+  const result=unionBoundConfidence(failures);
+  assert.deepEqual(result.value,{numerator:'7',denominator:'10'});
+  assert.deepEqual(result.failureSum,{numerator:'3',denominator:'10'});
+  assert.equal(result.status,'conditional-bound');assert.equal(result.trivial,false);
+  assert.deepEqual(unionBoundConfidence([...failures].reverse()).value,result.value);
+  assert.equal(JSON.stringify(failures),before);
+  // On 10 equally likely outcomes: disjoint failure sets of sizes 1 and 2
+  // attain 7/10; overlapping sets of sizes 1 and 2 give 8/10, above this bound.
+  for(const failed of [new Set([0,1,2]),new Set([0,1])])assert.ok((10-failed.size)/10>=.7);
+});
+test('T18 sum equal to or above one is explicitly trivial, never negative',()=>{
+  for(const ps of [['1/2','1/2'],['3/5','3/5']]){
+    const result=unionBoundConfidence(ps.map((p,i)=>declaration(String(i),p)));
+    assert.deepEqual(result.value,{numerator:'0',denominator:'1'});assert.equal(result.trivial,true);
+  }
+  assert.deepEqual(unionBoundConfidence([]).value,{numerator:'1',denominator:'1'});
+});
+test('T18 agreement cannot replace missing probabilities or justification',()=>{
+  assert.throws(()=>unionBoundConfidence([{id:'A',justification:'hypothesis:A'}] as DeclaredFailure[]),/probability required/);
+  assert.throws(()=>unionBoundConfidence([{id:'A',p:'1/10',justification:''}]),/justification reference required/);
+  assert.throws(()=>unionBoundConfidence([declaration('A','1/10'),declaration('A','1/10')]),/duplicate failure identity/);
+  assert.throws(()=>unionBoundConfidence([declaration('A','2')]),/probability outside/);
+  // Two declarations of certain failure still give zero despite their agreement.
+  assert.deepEqual(unionBoundConfidence([declaration('A','1'),declaration('B','1')]).value,{numerator:'0',denominator:'1'});
+});
diff --git a/test/measures/t12-capacity.test.ts b/test/measures/t12-capacity.test.ts
new file mode 100644
index 0000000..9489de5
--- /dev/null
+++ b/test/measures/t12-capacity.test.ts
@@ -0,0 +1,49 @@
+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {capacityBound,commonCauseCapacityBound} from '../../src/measures/capacity.ts';
+import type {RationalInput} from '../../src/measures/rational.ts';
+const policy={logarithm:'binary64-log2' as const};
+const near=(actual:number,expected:number)=>assert.ok(Math.abs(actual-expected)<1e-12,`${actual} != ${expected}`);
+test('T12 covering symmetric cause: fixed independent entropy oracles and endpoints',()=>{
+  for(const [c,q,expected] of [
+    ['0','1/2',2],['1','0',0.4150374992788439],['1','1',2],
+    ['1','1/2',0.20751874963942196],['1','1/4',0],
+    ['1/5','0',1.6830074998557687],['1/5','1/2',1.6415037499278844],
+  ] as const)near(commonCauseCapacityBound(4,c,q,policy).value,expected);
+  near(commonCauseCapacityBound(2,'1','0',policy).value,1); // invertible all-wrong binary channel
+});
+test('T12 copying one symmetric channel preserves joint-table mutual information',()=>{
+  // Uniform T: each diagonal joint mass is 1/8; each off-diagonal is 1/24.
+  // Duplicate the observed symbol, not the event mass: Y -> (Y,...,Y).
+  function information(copies:number,diagonal:number,offDiagonal:number){
+    const joint=Array.from({length:4},(_,truth)=>Array.from({length:4},(_,signal)=>({
+      truth,output:Array(copies).fill(signal).join(','),mass:truth===signal?diagonal:offDiagonal,
+    }))).flat();
+    const truthMass=new Map<number,number>(),outputMass=new Map<string,number>();
+    for(const event of joint){
+      truthMass.set(event.truth,(truthMass.get(event.truth)??0)+event.mass);
+      outputMass.set(event.output,(outputMass.get(event.output)??0)+event.mass);
+    }
+    near([...truthMass.values()].reduce((a,b)=>a+b,0),1);
+    assert.equal(outputMass.size,4);
+    return joint.reduce((sum,event)=>sum+event.mass*Math.log2(
+      event.mass/(truthMass.get(event.truth)!*outputMass.get(event.output)!)),0);
+  }
+  const expected=0.20751874963942196;
+  for(const copies of [1,2,20]){
+    const symmetric=information(copies,1/8,1/24);
+    near(symmetric,expected);
+    near(symmetric,commonCauseCapacityBound(4,'1','1/2',policy).value);
+    // q=1/4: every joint outcome has mass 1/16, even with identical copy counts.
+    near(information(copies,1/16,1/16),0);
+  }
+  near(commonCauseCapacityBound(4,'1','1/4',policy).value,0);
+  assert.notEqual(commonCauseCapacityBound(4,'1','1/2',policy).value,
+    capacityBound(4,'1',policy).value);
+});
+test('T12 q is mandatory only on the new symmetric-cause operation',()=>{
+  assert.throws(()=>commonCauseCapacityBound(4,'1/5',undefined as unknown as RationalInput,policy),/accuracy q required/);
+  assert.throws(()=>commonCauseCapacityBound(4,'1/5','3/2',policy),/probability outside/);
+  assert.throws(()=>commonCauseCapacityBound(4,'1/5','1/2',{} as typeof policy),/policy required/);
+  near(capacityBound(4,'1/5',policy).value,1.6830074998557687);
+});
diff --git a/test/measures/t87-phase.test.ts b/test/measures/t87-phase.test.ts
new file mode 100644
index 0000000..47989d9
--- /dev/null
+++ b/test/measures/t87-phase.test.ts
@@ -0,0 +1,33 @@
+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+import {cancels} from '../../src/field/encounter.ts';
+const load = (path:string) => JSON.parse(readFileSync(new URL(`../../${path}`,import.meta.url),'utf8'));
+// Proposed F4 arithmetic only. This is not an exported measure or a native reading adapter.
+const inDomain = ([n,p,s]:[number,number,number]) => Number.isSafeInteger(n)&&n>0&&Number.isSafeInteger(p)&&p>0&&
+  n%p===0&&Number.isSafeInteger(s)&&s>=0&&s<p;
+const ri = (n:number,p:number,s:number) => {
+  if(!inDomain([n,p,s])) throw new Error('provisional F4 domain');
+  const t=s/p;
+  const entropy=t===0?0:-t*Math.log2(t)-(1-t)*Math.log2(1-t);
+  return Math.log2(n/p)-entropy;
+};
+test('F4 provisional domain rejects nondivisors and out-of-domain shifts',()=>{
+  for(const c of load('samples/laws/t87/phase-domain.json').cases) {
+    assert.equal(inDomain(c.input),c.accepted);
+    if(!c.accepted) assert.throws(()=>ri(...c.input as [number,number,number]),/provisional F4 domain/);
+  }
+});
+test('F4 fixed phase controls show halfphase one bit below inphase; objective remains open',()=>{
+  const cs=load('vectors/laws/t87/phase-controls.json').cases;
+  for(const c of cs) assert.ok(Math.abs(ri(c.n,c.p,c.s)-c.expected)<1e-12);
+  assert.equal(ri(12,4,0)-ri(12,4,2),1);
+  assert.ok(ri(12,4,1)>ri(12,4,2));
+  assert.equal(ri(12,4,1),ri(12,4,3));
+});
+test('T87 raw angle-distance statement needs wrapped phase: 0 and 2pi reinforce',()=>{
+  const a={name:'a',phase:0}; const b={name:'b',phase:2*Math.PI};
+  assert.ok(Math.abs(a.phase-b.phase)>Math.PI/2);
+  assert.equal(cancels(a,b),false);
+  assert.ok(Math.abs((Math.cos(a.phase)+Math.cos(b.phase))**2+(Math.sin(a.phase)+Math.sin(b.phase))**2-4)<1e-12);
+});
diff --git a/test/t38-forms.test.ts b/test/t38-forms.test.ts
