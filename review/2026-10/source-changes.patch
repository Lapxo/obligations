diff --git a/src/measures/capacity.ts b/src/measures/capacity.ts
index 6f7cf3d..19ecd79 100644
--- a/src/measures/capacity.ts
+++ b/src/measures/capacity.ts
@@ -29,6 +29,23 @@ export function capacityBound(n:number,c:RationalInput,policy:LogarithmPolicy){
     status:'measured' as const,unit:'bits' as const,value:Math.log2(n)-numeric(factor)*Math.log2(n-1),
     meaning:'upper bound for every k; achievability depends on the private channel' as const};
 }
+/** Upper bound after revealing the independent covering-cause indicator.
+ * When active every observation copies one n-ary symmetric channel (accuracy q).
+ * When inactive the private observations are unrestricted. Copy count is no input.
+ * This is not finite-k mutual information or an achievability claim.
+ */
+export function commonCauseCapacityBound(n:number,c:RationalInput,accuracy:RationalInput,policy:LogarithmPolicy){
+  cardinality(n);logPolicy(policy);
+  if(accuracy===undefined||accuracy===null)refuse('common-cause accuracy q required');
+  const factor=probability(c),correct=probability(accuracy),wrong=sub(one,correct);
+  const conditional=entropy([correct,wrong])+numeric(wrong)*Math.log2(n-1);
+  return {model:'single-covering-symmetric-cause@1' as const,
+    parameters:{n,c:pack(factor),q:pack(correct)},policy,status:'measured' as const,unit:'bits' as const,
+    conditions:['uniform-truth','cause-indicator-independent-of-truth',
+      'active-cause-copies-one-symmetric-channel','inactive-private-channel-unrestricted'] as const,
+    value:Math.max(0,Math.log2(n)-numeric(factor)*conditional),
+    meaning:'upper bound after revealing cause indicator; copies do not add; no achievability claim' as const};
+}
 export function capacityP0(n:number,c:RationalInput,policy:LogarithmPolicy){
   const bound=capacityBound(n,c,policy),factor=probability(c);
   return {...bound,value:bound.value-entropy([factor,sub(one,factor)]),meaning:'mutual information at p=0 for every positive k' as const};
diff --git a/src/measures/confidence.ts b/src/measures/confidence.ts
new file mode 100644
index 0000000..1a8b194
--- /dev/null
+++ b/src/measures/confidence.ts
@@ -0,0 +1,28 @@
+import {add,sub,zero,one,pack,probability,type RationalInput} from './rational.ts';
+
+export type DeclaredFailure=Readonly<{id:string;p:RationalInput;justification:string}>;
+const refuse=(cause:string):never=>{throw new Error('REFUSE·confidence '+cause);};
+
+/** Conditional arithmetic only: callers must justify P(failure_i) <= p_i in one
+ * probability space. References are retained, not verified. No independence is
+ * needed; agreement/copy counts cannot supply the missing probabilities.
+ */
+export function unionBoundConfidence(failures:readonly DeclaredFailure[]){
+  if(!Array.isArray(failures))refuse('declared failures required');
+  let sum=zero;
+  const names=new Set<string>();
+  const declarations=failures.map(failure=>{
+    if(!failure||typeof failure.id!=='string'||failure.id.trim()==='')refuse('failure identity required');
+    if(names.has(failure.id))refuse('duplicate failure identity');
+    names.add(failure.id);
+    if(typeof failure.justification!=='string'||failure.justification.trim()==='')refuse('justification reference required');
+    if(failure.p===undefined||failure.p===null)refuse('declared failure probability required');
+    const p=probability(failure.p);sum=add(sum,p);
+    return {id:failure.id,p:pack(p),justification:failure.justification};
+  });
+  const trivial=sum[0]>=sum[1];
+  return {model:'declared-failure-union-bound@1' as const,status:'conditional-bound' as const,
+    unit:'probability' as const,conditions:['common-probability-space','each-failure-probability-justified'] as const,
+    declarations,failureSum:pack(sum),value:pack(trivial?zero:sub(one,sum)),trivial,
+    meaning:'lower bound for all declared events succeeding; references are not verified' as const};
+}
