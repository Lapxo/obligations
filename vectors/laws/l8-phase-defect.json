{
  "id": "L8",
  "classification": "law by finite enumeration",
  "policy": "vectors/laws/policy.json",
  "numeric": {
    "logarithm": "binary64-log2",
    "absoluteTolerance": 1e-12
  },
  "contract": {
    "domain": "n,p positive safe integers, p divides n; s integer with 0 <= s < p",
    "value": "D(n,p,s)=log2(n/p)-h(s/p), h(0)=h(1)=0",
    "minimum": "log2(n/p)-h(floor(p/2)/p); shifts floor(p/2),ceil(p/2), deduplicated, p=1 gives s=0",
    "maximum": "all shifts: s=0; nonzero shifts: empty for p=1, {1} for p=2, {1,p-1} for p>=3",
    "interpretation": "phase defect only; n>=2p is a nonnegative regime, not an information certificate",
    "scope": "Enumeration verifies only 3<=n<=64; no unrestricted proof or mutual-information claim"
  },
  "enumeration": {
    "nMinimum": 3,
    "nMaximum": 64,
    "divisorPairs": 277,
    "shifts": 3399,
    "nonzeroShifts": 3122
  },
