      "name": "omit-fixed-cut-limits",
      "source": "import M0Threshold046\nopen Obligations045.M0 Obligations046.Threshold Filter Topology\nnoncomputable section\nexample (M : Domain) (a : Fin M.K \u2192 Bool) (hdiag : score M a = (1:\u211d)/2)\n    (F : \u211d \u2192 \u211d) (hF : ContinuousAt F 0) (hF0 : F 0 = (1:\u211d)/2) :\n    Tendsto (fun N => conditionalError M N a) atTop (\ud835\udcdd ((1:\u211d)/2)) := by\n  apply floor_limit_diag_of_fixed_cut_limits M a hdiag F hF hF0\n",
      "exitCode": 1,
      "cause": [
        "unsolved goals"
      ]
    },
    "extraNegatives": [
      {
        "name": "omit-limit-continuity",
        "source": "import M0Threshold046\nopen Obligations045.M0 Obligations046.Threshold Filter Topology\nnoncomputable section\nexample (M : Domain) (a : Fin M.K \u2192 Bool) (hdiag : score M a = (1:\u211d)/2)\n    (F : \u211d \u2192 \u211d) (hF0 : F 0 = (1:\u211d)/2)\n    (hCLT : \u2200 z, Tendsto (fun N => cdf M a N z) atTop (\ud835\udcdd (F z))) :\n    Tendsto (fun N => conditionalError M N a) atTop (\ud835\udcdd ((1:\u211d)/2)) := by\n  apply floor_limit_diag_of_fixed_cut_limits M a hdiag F ?_ hF0 hCLT\n",
