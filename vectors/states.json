        "draft",
        "sent",
        "paid",
        "void",
        "cancelled"
      ],
      "demanded": [
        "draft",
        "sent",
        "paid"
      ],
      "permitted": [
        "draft",
        "sent",
        "void"
      ],
      "expect": {
        "REQUIRED": [
          "draft",
          "sent"
        ],
        "FREE": [
          "void"
        ],
        "FORBIDDEN": [
          "cancelled"
        ],
        "CONFLICT": [
          "paid"
        ]
      }
    },
    {
